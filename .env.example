# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
# The marketing pages work with none of these. The booking system and admin panel
# need the Supabase block below.

# ──────────────────────────────────────────────────────────────────────────────
# Site
# ──────────────────────────────────────────────────────────────────────────────
# WhatsApp number in international format, digits only (no "+", spaces or dashes).
# Montenegro: 382XXXXXXXX  |  Serbia: 381XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public URL of the deployed site (canonical + Open Graph URLs, links in e-mails)
NEXT_PUBLIC_SITE_URL=

# ──────────────────────────────────────────────────────────────────────────────
# Supabase (REQUIRED for /booking and /admin)
# Project → Settings → API
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server only. Never prefix with NEXT_PUBLIC_ and never commit.
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Notifications (OPTIONAL — leave empty to disable; the app never claims a message
# was sent when it was not. Results are logged per booking in the admin panel.)
# ──────────────────────────────────────────────────────────────────────────────
# WhatsApp Cloud API (Meta). Messages to your own admin number need an approved
# template if the 24h window is closed — see README.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional approved template name (body: 1 parameter = booking summary)
WHATSAPP_ADMIN_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=sr

# E-mail via Resend (https://resend.com). EMAIL_FROM must be a verified sender,
# e.g. "Adrirora Travel <rezervacije@your-domain.com>"
RESEND_API_KEY=
EMAIL_FROM=
