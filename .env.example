# Copy to .env.local and fill in. All values are optional; defaults live in src/config/site.ts

# WhatsApp number in international format, digits only (no "+", spaces or dashes).
# Example format for Montenegro: 382XXXXXXXX  |  Serbia: 381XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public URL of the deployed site (used for canonical + Open Graph URLs)
NEXT_PUBLIC_SITE_URL=
